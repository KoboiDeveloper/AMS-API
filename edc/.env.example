# EDC bridge — set as Render Environment Variables (edc/.env is NOT deployed).
# Copy values from your local edc/.env or ITILPOS .env.example.

SQL_PROFILE=lokal

# --- Profil Lokal (remote SQL) — used when SQL_PROFILE=lokal ---
SQL_LOKAL_SERVER=your-sql-host-or-ip
SQL_LOKAL_PORT=1433
SQL_LOKAL_DATABASE=SPACEX
SQL_LOKAL_USER=sa
SQL_LOKAL_PASSWORD=
SQL_LOKAL_ENCRYPT=false
SQL_LOKAL_TRUST_CERT=true

# --- Profil Toko (POS di toko) — used when SQL_PROFILE=toko ---
# SQL_TOKO_SERVER=host-or-instance
# SQL_TOKO_PORT=1433
# SQL_TOKO_DATABASE=NEW_POS
# SQL_TOKO_USER=sa
# SQL_TOKO_PASSWORD=
# SQL_TOKO_ENCRYPT=false
# SQL_TOKO_TRUST_CERT=true

# --- Fallback (optional) ---
# SQL_SERVER=
# SQL_DATABASE=
# SQL_USER=
# SQL_PASSWORD=

SQL_TABLE_LOG=dbo.LOG_TIPE_BAYAR
SQL_TABLE_MID=dbo.MID_MASTER

# Store default when request omits storeId
# EDC_STORE_ID=

# --- Bank credentials (BCA / BNI / BRI / Mandiri) — same as ITILPOS ---
# BCA_CLIENT_ID=
# BCA_CLIENT_SECRET=
# BCA_CHANNEL_ID=
# BCA_PARTNER_ID=
# BCA_PRIVATE_KEY_PATH=keys/private_key.pem
# BCA_PUBLIC_KEY_PATH=keys/public_key.pem
# MDR_* BNI_* BRI_* ...

# Render: upload PEM keys via secret files or paste paths if bundled in repo (not recommended).
