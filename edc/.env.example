# Local EDC bridge (PC toko) — same pattern as ITILPOS.
# Copy to edc/.env (NOT deployed to Render). Restart `npm start` after changes.

# --- SQL POS lokal (MID_MASTER / LOG_TIPE_BAYAR) ---
SQL_PROFILE=toko

# Named instance: jangan set PORT
SQL_TOKO_SERVER=.\SQLEXPRESS
SQL_TOKO_DATABASE=NEW_POS
SQL_TOKO_USER=sa
SQL_TOKO_PASSWORD=
SQL_TOKO_ENCRYPT=false
SQL_TOKO_TRUST_CERT=true

SQL_TABLE_LOG=dbo.LOG_TIPE_BAYAR
SQL_TABLE_MID=dbo.MID_MASTER

# Optional override STORE (default: first STORE in MID_MASTER)
# EDC_STORE_ID=

# HTTP listen (POS_React: REACT_APP_EDC_API_BASE_URL=http://127.0.0.1:8787)
EDC_HTTP_HOST=127.0.0.1
EDC_HTTP_PORT=8787

# --- Bank credentials (same keys as ITILPOS / NEW EDC) ---
# BCA_CLIENT_ID=
# BCA_CLIENT_SECRET=
# BCA_CHANNEL_ID=
# BCA_PARTNER_ID=
# BCA_PRIVATE_KEY_PATH=keys/private_key.pem
# BCA_PUBLIC_KEY_PATH=keys/public_key.pem
# MDR_* BNI_* BRI_* ...

# Optional remote profile (dev only — NOT for toko MID)
# SQL_PROFILE=lokal
# SQL_LOKAL_SERVER=
# SQL_LOKAL_PORT=1433
# SQL_LOKAL_DATABASE=
# SQL_LOKAL_USER=
# SQL_LOKAL_PASSWORD=
